{
  "extends": "next/core-web-vitals",
  "plugins": ["@typescript-eslint"],
  "rules": {
    "semi": "error",
    "quotes": ["error", "single"],
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": "error",
    "object-curly-spacing": ["error", "always"],
    "comma-dangle": ["error", "only-multiline"]
  }
}
